{
  "manifest_version": 3,
  "name": "Version Everywhere",
  "description": "Shows the Thunderbird channel and version in every window and tab.",
  "version": "1.0.0",
  "author": "Thunderbird",
  "browser_specific_settings": {
    "gecko": {
      "id": "version-everywhere@thunderbird.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["channel.js", "background.js"]
  },
  "icons": {
    "32": "icons/release.svg"
  },
  "action": {
    "default_title": "Version Everywhere",
    "default_icon": "icons/release.svg",
    "allowed_spaces": []
  },
  "compose_action": {
    "default_title": "Version Everywhere",
    "default_icon": "icons/release.svg"
  },
  "message_display_action": {
    "default_title": "Version Everywhere",
    "default_icon": "icons/release.svg"
  }
}
